// OwlLang — test Blockchain init
class Block {
  fn init(index, data) {
    this.index = index;
    this.data = data;
  }
}

class Blockchain {
  fn init() {
    this.chain = [];
    let genesis = new Block(0, "Genesis");
    this.chain = [genesis];
  }

  fn getLatest() {
    let n = len(this.chain);
    return this.chain[n - 1];
  }
}

let bc = new Blockchain();
print len(bc.chain);
