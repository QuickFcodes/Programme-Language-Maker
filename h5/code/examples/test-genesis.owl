// OwlLang — test genesis hash
class Block {
  fn init(index, data, prevHash) {
    this.index = index;
    this.data = data;
    this.prevHash = prevHash;
    this.hash = this.computeHash();
  }

  fn computeHash() {
    let h = this.index * 31;
    h = h + len(this.data);
    h = h + len(this.prevHash);
    return h;
  }
}

class Blockchain {
  fn init() {
    let genesis = new Block(0, "Genesis", "0");
    this.chain = [genesis];
  }

  fn test() {
    let g = this.chain[0];
    print g.hash;
  }
}

let bc = new Blockchain();
bc.test();
